# Super Health App - Environment Variables Configuration

# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# Redis
REDIS_PORT=6379

# Google Gemini API Key (Obtain from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret Key
JWT_SECRET=super_secret_jwt_key_at_least_256_bits_long_for_security_12345

# AWS Deployment
AWS_REGION=ap-southeast-1
AWS_ACCOUNT_ID=123456789012

